# ==========================================
# GramVikas AI — Backend Environment Template
# ==========================================

# Application Environment (development, staging, production)
APP_ENV=development

# Database Connection URL
# For local SQLite development (default):
DATABASE_URL=sqlite:///./gramvikas.db
# For PostgreSQL / Supabase in production:
# DATABASE_URL=postgresql://postgres.xxx:password@aws-0-region.pooler.supabase.com:6543/postgres

# JWT Secret Key (Generate a 64-char random hex key for production)
JWT_SECRET=gramvikas_ai_sih_2026_super_secure_secret_key_change_in_production_9013cb
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# External AI Configuration (Google Gemini API)
# Obtain free API key from Google AI Studio (https://aistudio.google.com/)
# If empty, the backend seamlessly runs in labelled deterministic fallback mode
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Frontend CORS Allowed Origins
FRONTEND_ORIGIN=http://localhost:3000
ALLOWED_ORIGINS=["http://localhost:3000", "http://127.0.0.1:3000", "https://gramvikas-ai.vercel.app"]

# File Storage
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_BYTES=10485760
